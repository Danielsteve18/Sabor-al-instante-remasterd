# Copiar a .env.local y rellenar con los valores del panel de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# URL pública base, sin barra final. La usan los enlaces de confirmación de Supabase.
# Local: http://localhost:3000 · Producción: https://sabor-al-instante-remasterd.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo servidor. Nunca exponer al cliente ni versionar el valor real.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
