# Normaliza los finales de línea a LF en todo el repositorio
* text=auto eol=lf

# Archivos binarios: sin conversión
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.gif binary
*.pdf binary
*.woff binary
*.woff2 binary

# Scripts que deben conservar LF para ejecutarse en sh
*.sh text eol=lf
.githooks/* text eol=lf
